# DeepSeek is configured in config/llm.toml, not in this file.
# Copy config/llm.example.toml to config/llm.toml and fill in your key.

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=llm-serving-incident-agent

# Strict two-stage Hybrid RAG. Keyword is only an explicit evaluation baseline.
# RAG_PROVIDER=hybrid
# RAG_FINAL_TOP_K=3
# RAG_BM25_TOP_K=20
# RAG_DENSE_TOP_K=20
# RAG_RRF_K=60
# RAG_RRF_CANDIDATE_K=30
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_DEVICE=cuda
# RAG_STRICT=true
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CHROMA_DIR=data/chroma

# Agent safety limits.
# MAX_AGENT_STEPS=5
# AGENT_TIMEOUT_SECONDS=60
# TOOL_TIMEOUT_SECONDS=5
