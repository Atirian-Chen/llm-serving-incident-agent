# DeepSeek is configured in config/llm.toml, not in this file.
# Copy config/llm.example.toml to config/llm.toml and fill in your key.

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=llm-serving-incident-agent

# Optional BGE + Chroma retrieval. Keyword retrieval remains the lightweight default.
# RAG_PROVIDER=keyword
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CHROMA_DIR=data/chroma

# Agent safety limits.
# MAX_AGENT_STEPS=5
# AGENT_TIMEOUT_SECONDS=60
# TOOL_TIMEOUT_SECONDS=5
