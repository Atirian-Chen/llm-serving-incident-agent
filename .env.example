# Default is deterministic and works without an API key.
MODEL_PROVIDER=rule

# For a vLLM/SGLang OpenAI-compatible endpoint:
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=local-dev-key
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_MODEL=your-model-name

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=llm-serving-incident-agent

# Optional BGE + Chroma retrieval. Keyword retrieval remains the offline default.
# RAG_PROVIDER=keyword
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CHROMA_DIR=data/chroma

